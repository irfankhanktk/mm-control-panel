# Copy to .env.local for local development. In deployed environments set these as real
# environment variables instead (the values here are examples only).

# Base URL of the MyMasjid API for this environment, without a trailing slash.
# Read on the server only; it is never sent to the browser.
#   local   : http://localhost:6574
#   staging : https://<staging api host>
MM_API_BASE_URL=http://localhost:6574

# Secret used to sign the session cookie. At least 32 characters; use a different value per
# environment. Generate one with:  openssl rand -base64 32
AUTH_SESSION_SECRET=

# Only if MM_API_BASE_URL is an https address with a self-signed developer certificate:
# NODE_TLS_REJECT_UNAUTHORIZED=0
